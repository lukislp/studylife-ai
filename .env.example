# Copy to .env and adjust. Never commit the real .env file.

APP_NAME="StudyLife AI"
ENVIRONMENT=local
LOG_LEVEL=INFO

# LiteLLM model identifier — selects both provider and model.
# Local (no API key needed, requires `docker compose exec ollama ollama pull llama3.2`):
LLM_MODEL=ollama/llama3.2
LLM_API_BASE=http://localhost:11434
LLM_REQUEST_TIMEOUT_SECONDS=60

# To use an API provider instead, e.g. OpenAI:
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_API_BASE=
#   OPENAI_API_KEY=sk-...        # read directly by LiteLLM, not by this app

# StudyLife REST API (ingestion source, M2). Generate the key once via the
# StudyLife setup UI (Settings -> "studylife-ai connection" card) after
# logging in with a passkey — a dedicated key slot, separate from the
# Home Assistant integration's key, so revoking/rotating one never affects
# the other. See docs/decisions.md.
STUDYLIFE_API_BASE_URL=http://localhost:8080
STUDYLIFE_API_KEY=
# Arbitrary label stored on every ingested chunk — not a StudyLife-internal
# ID (the API doesn't expose one). Keeps multi-user filtering possible later
# without re-ingesting everything. See docs/decisions.md.
STUDYLIFE_USER_ID=primary

# Embedding model, same LiteLLM provider-agnostic convention as LLM_MODEL.
# Local (requires `docker compose exec ollama ollama pull nomic-embed-text`):
EMBEDDING_MODEL=ollama/nomic-embed-text
# API alternative: EMBEDDING_MODEL=openai/text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=studylife_notes

# Chunking (see docs/decisions.md "Chunking strategy")
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
