# Copy to .env and adjust. Never commit the real .env file.

APP_NAME="StudyLife AI"
ENVIRONMENT=local
LOG_LEVEL=INFO

# LiteLLM model identifier — selects both provider and model.
# Local (no API key needed, requires `docker compose exec ollama ollama pull llama3.2`):
LLM_MODEL=ollama/llama3.2
LLM_API_BASE=http://localhost:11434
LLM_REQUEST_TIMEOUT_SECONDS=60

# To use an API provider instead, e.g. OpenAI:
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_API_BASE=
#   OPENAI_API_KEY=sk-...        # read directly by LiteLLM, not by this app

# StudyLife REST API - one shared instance URL for all users. Required for
# ingestion and /agent (which builds a real per-user StudyLifeClient from a
# registered key - see REGISTERED_KEYS_DB_PATH below); /chat never calls
# StudyLife's API at all.
STUDYLIFE_API_BASE_URL=http://localhost:8080
# Shared secret StudyLife's backend signs short-lived per-request proxy
# tokens with (see docs/decisions.md "M4.5 Multi-user support" - "Auth flow,
# take two"). MUST match the same value configured on the StudyLife side
# exactly, or every /chat and /agent request fails with 401. Also
# authenticates POST /internal/register-key and /internal/revoke-key.
# Generate with e.g. `openssl rand -base64 32`.
STUDYLIFE_SHARED_SECRET=
# Rolling lookback window (days, from "now") for ingesting study sessions.
# A session older than this is dropped from the index on the next sync —
# see docs/decisions.md "Ingestion scope expansion".
STUDYLIFE_SESSION_HISTORY_DAYS=1825
# How often the in-process background loop re-syncs every registered account -
# see docs/decisions.md "Periodic ingestion sync".
INGESTION_SYNC_INTERVAL_SECONDS=60

# Embedding model, same LiteLLM provider-agnostic convention as LLM_MODEL.
# Local (requires `docker compose exec ollama ollama pull nomic-embed-text`):
EMBEDDING_MODEL=ollama/nomic-embed-text
# API alternative: EMBEDDING_MODEL=openai/text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=studylife_notes

# Chunking (see docs/decisions.md "Chunking strategy")
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# Retrieval (see docs/decisions.md "Retrieval design" and "Retrieval quality:
# reranking + per-content-type quota"): pure vector search, user_id-only
# filter. RETRIEVAL_TOP_K is the final chunk count handed to the LLM;
# RERANK_CANDIDATE_K is the candidate pool fetched first (always active,
# split evenly across the 4 content types); RERANK_MODEL optionally reorders
# that pool with an LLM before truncating to RETRIEVAL_TOP_K.
RETRIEVAL_TOP_K=8
RERANK_CANDIDATE_K=20
# RERANK_MODEL=openai/gpt-4o   # unset = candidate pool sorted by vector-similarity score only.
# gpt-4o-mini was tried first and is cheaper, but live-testing showed it unreliable at ranking
# 40+ candidates even with deterministic date labels and temperature=0 (see docs/decisions.md
# "Reranker model upgraded") - gpt-4o is the smallest model confirmed reliable for this so far.

# Half-width (days) of the "near today" session date-window fetched via a real Qdrant
# DatetimeRange filter - see docs/decisions.md "Structured session dates". Doesn't limit
# topic-based session questions, only the near-term date-window pool.
SESSION_WINDOW_DAYS=14
# Cap on session chunks kept from that date-window - see docs/decisions.md "Session window
# capacity". Deliberately its own setting, not the shared per-content-type quota, so a busy
# nearby day can't starve an equally-near day.
SESSION_WINDOW_TOP_K=20

# Optional: resolve a query's own date-range expression (e.g. "letzte Woche") via a dedicated
# LLM call before retrieval, replacing the fixed ±SESSION_WINDOW_DAYS window for that query only
# - see docs/decisions.md "NL date-range resolution". Unset = current fixed-window behavior,
# unchanged for every query.
# DATE_PARSE_MODEL=openai/gpt-4o
# Cap on session chunks kept when DATE_PARSE_MODEL resolved an exact date range - exempted from
# the shared RETRIEVAL_TOP_K cut, since every chunk in an exact range is unconditionally
# relevant. See docs/decisions.md "Exempt exact date-range matches from the shared retrieval_top_k".
DATE_RANGE_CHUNK_CAP=60

# RAGAS eval judge (M3, see docs/decisions.md "Eval design"): must be a model
# independent of LLM_MODEL, so it doesn't grade its own answers.
EVAL_JUDGE_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...        # read directly by LiteLLM, not by this app
# Fixed Qdrant partition the eval pipeline reads/writes under - decoupled
# from any real StudyLife/INGESTION_USERS entry.
EVAL_USER_ID=eval-user

# M4 agent (see docs/decisions.md "M4 agent stack"): SQLite file storing
# paused agent state between a proposed write action (POST /agent) and its
# confirmation (POST /agent/confirm) - survives a service restart.
AGENT_CHECKPOINT_DB_PATH=agent_checkpoints.db

# M4.5 (see docs/decisions.md "M4.5 Multi-user support"): SQLite file
# storing each user's real AiApiKey, registered automatically by StudyLife's
# backend (POST /internal/register-key) the moment they generate one - not
# something you set manually. Used by /agent (to build a real StudyLifeClient
# for the calling user) and by ingestion (which syncs every registered user).
REGISTERED_KEYS_DB_PATH=registered_keys.db

# Rate limiting (see docs/decisions.md "Rate limiting"): a fixed-window request counter per
# resolved user, guarding /chat, /agent, and /agent/confirm - the endpoints that incur real LLM
# cost. In-memory only, fine for a single-replica deployment (see k8s/04-app.yaml).
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
